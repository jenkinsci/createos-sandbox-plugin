<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core"
         xmlns:f="/lib/form"
         xmlns:c="/lib/credentials">

    <f:entry title="SSH Credentials" field="credentialsId"
             description="Jenkins SSH private key credential. Its username must exist in the sandbox root filesystem; the matching public key is derived from it and injected into authorized_keys.">
        <c:select />
    </f:entry>

</j:jelly>
