<?jelly escape-by-default='true'?>
<!--
    Config form for CreateOS Cloud.
    Shown in: Manage Jenkins > Clouds > Add a new cloud > CreateOS Sandbox

    This is like a settings page — users fill in their API URL, credentials, etc.
    Each <f:entry> is a form field. The 'field' attribute maps to a Java getter/setter.
-->
<j:jelly xmlns:j="jelly:core"
         xmlns:f="/lib/form"
         xmlns:c="/lib/credentials">

    <!--
        The cloud identifier is set on the "add a new cloud" page, not here, but it still has to
        round-trip through this form: without it a newly created cloud has no name to save under
        and the first save fails.
    -->
    <f:invisibleEntry>
        <f:textbox field="name" />
    </f:invisibleEntry>

    <f:entry title="Display Name" field="displayName"
             description="Optional name shown in Manage Jenkins > Clouds. The cloud identifier cannot be changed here.">
        <f:textbox />
    </f:entry>

    <f:entry title="API URL" field="apiUrl"
             description="CreateOS Sandbox API base URL (e.g. https://api.sb.createos.sh)">
        <f:textbox default="https://api.sb.createos.sh" />
    </f:entry>

    <f:entry title="Credentials" field="credentialsId"
             description="CreateOS API key (stored as a Secret text credential)">
        <c:select />
    </f:entry>

    <f:entry title="Container Cap" field="containerCap"
             description="Maximum number of Jenkins sandbox agents to run simultaneously">
        <f:number default="100" min="1" />
    </f:entry>

    <f:entry title="Exec Sandbox Cap" field="execSandboxCap"
             description="Maximum number of concurrent createosSandbox Pipeline blocks">
        <f:number default="100" min="1" />
    </f:entry>

    <f:validateButton title="Test Connection" progress="Testing..."
                      method="testConnection"
                      with="apiUrl,credentialsId" />

    <f:entry title="Sandbox Templates"
             description="Templates are checked in this order when labels overlap. Drag to reorder.">
        <f:repeatableProperty field="templates" header="Template" />
    </f:entry>

    <f:entry description="A controller restart reconnects agents to their surviving sandboxes, so a build resumes where it left off, unless their template enables 'Delete agents on controller restart'. Sandboxes keep running, and billing, while the controller is down." />

</j:jelly>
