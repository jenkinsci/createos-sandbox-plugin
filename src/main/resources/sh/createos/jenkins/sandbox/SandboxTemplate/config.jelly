<?jelly escape-by-default='true'?>
<!--
    Config form for a Sandbox Template.
    Shown inside the CreateOS Cloud config as a repeatable block.
    Users can add multiple templates (like PodTemplates in Kubernetes plugin).
-->
<j:jelly xmlns:j="jelly:core"
         xmlns:f="/lib/form">

    <f:entry title="Label" field="label"
             description="Jenkins label for matching jobs (e.g. 'createos' or 'nodejs')">
        <f:textbox clazz="required" checkMessage="Label is required" />
    </f:entry>

    <f:entry title="Shape" field="shape"
             description="Sandbox VM size (e.g. s-1vcpu-1gb, s-4vcpu-4gb)">
        <f:textbox default="s-1vcpu-1gb" clazz="required" checkMessage="Shape is required (e.g. s-1vcpu-1gb)" />
    </f:entry>

    <f:entry title="Root Filesystem" field="rootfs"
             description="Base image for the sandbox (e.g. devbox:1, ubuntu:22.04)">
        <f:textbox default="devbox:1" clazz="required" checkMessage="Root filesystem is required (e.g. devbox:1)" />
    </f:entry>

    <f:entry title="Remote FS" field="remoteFs"
             description="Workspace directory inside the sandbox">
        <f:textbox default="/home/jenkins" />
    </f:entry>

    <f:dropdownDescriptorSelector field="launcher" title="Launch Method" />

    <f:entry field="allowPipelineOverrides"
             description="When disabled, Jenkinsfiles may still select this template by label, but may not inherit from it and override shape, rootfs, remoteFs, networks, disks, or region.">
        <f:checkbox title="Allow Pipeline-defined Overrides" default="true" />
    </f:entry>

    <f:entry title="Region" field="region"
             description="Optional CreateOS region. Leave empty to use the API default.">
        <f:textbox />
    </f:entry>

    <f:entry title="Root Disk Size (MiB)" field="diskMiB"
             description="Optional root disk size override. 0 uses the shape default.">
        <f:number default="0" min="0" />
    </f:entry>

    <f:entry title="Private Networks" field="networks"
             description="Existing CreateOS network ids or names, separated by commas or new lines.">
        <f:textarea />
    </f:entry>

    <f:entry field="reuseAgent"
             description="By default an agent takes one build and is then deleted with its sandbox. When enabled, it stays up for further builds and its sandbox keeps billing while idle.">
        <f:checkbox title="Reuse agent between builds" />
    </f:entry>

    <f:entry title="Idle Timeout (minutes)" field="idleMinutes"
             description="An idle agent is deleted with its sandbox after this many minutes. With agent reuse enabled, 0 keeps agents forever.">
        <f:number default="1" min="0" />
    </f:entry>

    <f:entry field="deleteOnRestart"
             description="By default a controller restart reconnects agents and their builds resume. When enabled, a restart deletes this template's agents and sandboxes instead, and running builds fail.">
        <f:checkbox title="Delete agents on controller restart" />
    </f:entry>

    <f:entry title="Disks">
        <f:repeatableProperty field="disks" />
    </f:entry>

    <f:entry>
        <div align="right">
            <f:repeatableDeleteButton />
        </div>
    </f:entry>

</j:jelly>
